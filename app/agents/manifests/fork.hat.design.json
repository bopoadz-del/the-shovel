{
 "manifest_version": "1.0",
 "id": "fork.hat.design",
 "name": "Design Hat",
 "description": "Structural and geotechnical design checks: loads, beams, columns, reinforced concrete and steel members, masonry and earthwork design parameters.",
 "kind": "hat",
 "extends": "fork.base",
 "discipline": "design",
 "system_prompt_guidance": "You are the design discipline agent. You check structural and geotechnical designs with the platform's design formulas: loads, beam and column capacity, reinforced concrete and steel members, masonry and earthwork parameters. Take every input from the user or a cited project document, state the code or standard each check follows, and say when an input is missing rather than assume it. When a design result changes quantities, hand off to Quantities; when it raises a quality acceptance question, hand off to QAQC.",
 "activation": {
  "triggers": [
   {
    "type": "keyword",
    "value": "structural design",
    "score": 0.8
   },
   {
    "type": "keyword",
    "value": "beam",
    "score": 0.8
   },
   {
    "type": "keyword",
    "value": "column",
    "score": 0.8
   },
   {
    "type": "keyword",
    "value": "bending moment",
    "score": 0.8
   },
   {
    "type": "keyword",
    "value": "deflection",
    "score": 0.8
   },
   {
    "type": "keyword",
    "value": "reinforcement",
    "score": 0.8
   },
   {
    "type": "keyword",
    "value": "rebar design",
    "score": 0.8
   },
   {
    "type": "keyword",
    "value": "load combination",
    "score": 0.8
   },
   {
    "type": "keyword",
    "value": "steel member",
    "score": 0.8
   },
   {
    "type": "keyword",
    "value": "footing design",
    "score": 0.8
   },
   {
    "type": "keyword",
    "value": "retaining wall design",
    "score": 0.8
   },
   {
    "type": "keyword",
    "value": "masonry wall",
    "score": 0.8
   },
   {
    "type": "keyword",
    "value": "bearing capacity",
    "score": 0.8
   }
  ],
  "mode": "hybrid",
  "default_enabled": true
 },
 "context_sources": [
  {
   "kind": "project_documents",
   "weight": 1.0,
   "max_items": 10
  },
  {
   "kind": "official_guidance",
   "weight": 0.8,
   "max_items": 5
  }
 ],
 "allowed_actions": [
  "construction_calc:beam_deflection_cantilever_point_load",
  "construction_calc:beam_deflection_cantilever_udl",
  "construction_calc:beam_deflection_ss_point_load_midspan",
  "construction_calc:beam_deflection_ss_udl",
  "construction_calc:beam_moment_fixed_udl",
  "construction_calc:beam_moment_point_load",
  "construction_calc:beam_moment_simple",
  "construction_calc:beam_shear_simple",
  "construction_calc:bolt_shear_capacity",
  "construction_calc:carbon_footprint_concrete",
  "construction_calc:column_axial_capacity",
  "construction_calc:composite_column_design",
  "construction_calc:concrete_mix_design_sg",
  "construction_calc:concrete_mix_slip_form",
  "construction_calc:dewatering_uplift_check",
  "construction_calc:dewatering_well_point_spacing",
  "construction_calc:foundation_bearing_pressure",
  "construction_calc:live_load_reduction",
  "construction_calc:masonry_wall_capacity",
  "construction_calc:modulus_of_elasticity_concrete",
  "construction_calc:post_tensioning_force",
  "construction_calc:precast_beam_erection_check",
  "construction_calc:rc_beam_moment_capacity",
  "construction_calc:rc_beam_shear_capacity",
  "construction_calc:rebar_lap_length",
  "construction_calc:seismic_base_shear",
  "construction_calc:shear_stress_check",
  "construction_calc:slab_thickness_min",
  "construction_calc:slope_fos_simple",
  "construction_calc:steel_tension_capacity",
  "construction_calc:thermal_shrinkage_equivalence",
  "construction_calc:unit_weight_concrete",
  "construction_calc:weld_capacity",
  "construction_calc:wind_pressure"
 ],
 "available_tools": [],
 "handoffs": [
  {
   "to": "quantities",
   "when": "a design result changes quantities",
   "carry": [
    "member",
    "dimensions",
    "design_result"
   ]
  },
  {
   "to": "qaqc",
   "when": "a design result raises a quality acceptance question",
   "carry": [
    "member",
    "design_result",
    "standard"
   ]
  }
 ],
 "verification": {
  "grounding": "documents_or_formulas",
  "cite_required": true,
  "refuse_unaided_figures": true,
  "standards_advisory": true
 },
 "failure_policy": {
  "on_missing_context": "ask_clarifying",
