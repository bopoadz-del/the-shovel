{
  "version": "2.0",
  "description": "Generic construction procedure catalogue, keyed by procedure KIND. It ships no document codes or document titles of any organisation: a live procedure document's own code is resolved at run time from the corpus (app.core.procedure_catalogue).",
  "procedures": {
    "request_for_information": {
      "kind": "request_for_information",
      "label": "request for information procedure",
      "match_phrases": [
        "request for information",
        "rfi"
      ],
      "title": "Request for Information",
      "category": "project_controls",
      "purpose": "Control and resolve technical enquiries from Prime Contractor",
      "document_prefix": "RFI",
      "document_format": "RFI-{4d}",
      "roles": {
        "authorizer": "Programme Director",
        "initiator": "Prime Contractor",
        "responder": "Delivery Manager",
        "logger": "Document Controller"
      },
      "required_fields": [
        "rfi_number",
        "subject",
        "technical_query",
        "required_by_date",
        "response",
        "closure_date"
      ],
      "statuses": [
        "OPEN",
        "RESPONDED",
        "CLOSED",
        "OVERDUE"
      ],
      "rules": [
        "RFI is a technical enquiry only - NOT a design change request",
        "Every RFI must be logged in the Document Control System",
        "Response must be factual"
      ]
    },
    "risk_management": {
      "kind": "risk_management",
      "label": "risk management procedure",
      "match_phrases": [
        "risk management",
        "risk register"
      ],
      "title": "Risk Management",
      "category": "project_controls",
      "purpose": "Identify, record, and manage programme and project risks",
      "document_prefix": "RISK",
      "roles": {
        "authorizer": "Project Director",
        "owner": "Delivery Manager",
        "programme_risk": "PMC Head Project Controls",
        "cost_risk": "Chief Cost Manager",
        "register_maintainer": "Planning Managers"
      },
      "risk_format": "If [condition] Then [impact]",
      "scoring": {
        "probability_scale": [
          1,
          2,
          3,
          4,
          5
        ],
        "impact_scale": [
          1,
          2,
          3,
          4,
          5
        ],
        "score_formula": "probability * impact",
        "thresholds": {
          "green": [
            1,
            4
          ],
          "amber": [
            5,
            9
          ],
          "red": [
            10,
            25
          ]
        }
      },
      "impact_categories": [
        "Cost",
        "Time",
        "Quality",
        "Safety",
        "Reputation"
      ],
      "review_cadence": "Monthly with client",
      "system": "project risk register"
    },
    "work_package_control": {
      "kind": "work_package_control",
      "label": "work package control procedure",
      "match_phrases": [
        "work package"
      ],
      "title": "Work Package Control",
      "category": "project_controls",
      "purpose": "Track and control work packages",
      "document_prefix": "WP",
      "template": "work_package_control_register",
      "required_fields": [
        "wp_number",
        "description",
        "planned_start",
        "actual_start",
        "planned_completion",
        "actual_completion",
        "percent_complete",
        "responsible_party"
      ],
      "statuses": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "COMPLETE",
        "OVERDUE",
        "ON_HOLD"
      ],
      "templates": {
        "work_package_control_register": "Work Package Control Register"
      }
    },
    "quality_audit": {
      "kind": "quality_audit",
      "label": "quality assurance audit procedure",
      "match_phrases": [
        "quality assurance audit",
        "qa audit",
        "quality audit"
      ],
      "title": "Project Quality Assurance Audit",
      "category": "quality",
      "purpose": "PMC performs QA audits on Consultants and Contractors QA/QC Programs",
      "cadence": "As scheduled per audit plan",
      "finding_severity": [
        "Critical",
        "Major",
        "Minor",
        "Observation"
      ],
      "auto_ncr_trigger": [
        "Critical",
        "Major"
      ],
      "roles": {
        "process_owner": "PMC QA/QC Manager / PQR",
        "approver": "Employer's Representative",
        "participant_signatory": "PMC Project Director",
        "informed": "PMC Delivery Manager / Concerned Manager / Engineer"
      }
    },
    "non_conformance": {
      "kind": "non_conformance",
      "label": "non-conformance procedure",
      "match_phrases": [
        "non-conformance",
        "non conformance",
        "ncr"
      ],
      "title": "Construction Non-Conformance Reporting",
      "category": "quality",
      "purpose": "Disposition of Contractor NCRs",
      "document_prefix": "NCR",
      "document_format": "NCR-{YYYY}-{3d}",
      "ncr_types": {
        "physical": "Dimension or material deviation from specifications/drawings",
        "documentary": "Failure to provide test results or quality records"
      },
      "dispositions": {
        "USE_AS_IS": "Non-conformance acceptable without repair",
        "REPAIR": "Bring into conformance by rework",
        "REJECT": "Remove and replace",
        "CONCESSION": "Waiver from Employer required"
      },
      "roles": {
        "initiator": "Supervision Consultant (Engineer)",
        "signatory": [
          "PMC Delivery/Construction Manager",
          "Supervision Consultant"
        ],
        "approver": "Employer's Representative",
        "action": "Contractor",
        "participant": [
          "PMC Project QA/QC Manager"
        ],
        "informed": [
          "PMC Contracts Manager"
        ]
      },
      "workflow": [
        "Supervision Consultant raises NCR",
        "Contractor acknowledges and proposes disposition",
        "PMC QA/QC reviews disposition",
        "PMC Delivery Manager signs off",
        "Employer's Representative approves",
        "Contractor implements corrective action",
        "Supervision Consultant verifies closure",
        "NCR closed"
      ],
      "statuses": [
        "RAISED",
        "ACKNOWLEDGED",
        "DISPOSITION_PROPOSED",
        "DISPOSITION_REVIEWED",
        "APPROVED",
        "IMPLEMENTING",
        "VERIFYING",
        "CLOSED"
      ]
    },
    "testing_commissioning": {
      "kind": "testing_commissioning",
      "label": "testing and commissioning procedure",
      "match_phrases": [
        "testing and commissioning",
        "testing & commissioning",
        "commissioning"
      ],
      "title": "Testing & Commissioning",
      "category": "quality",
      "purpose": "Define testing and commissioning process per contract requirements",
      "scopes": {
        "rides": {
          "performer": "Vendor",
          "witness": "PMC specialist systems manager",
          "approver": "Independent Certifier"
        },
        "mep_infrastructure_building": {
          "performer": "Contractor",
          "witness": [
            "Supervision Consultant",
            "PMC"
          ],
          "approver": "Supervision Consultant"
        }
      },
      "test_statuses": [
        "PASS",
        "FAIL",
        "CONDITIONAL_PASS",
        "PENDING_WITNESSING"
      ],
      "hold_point_types": {
        "WITNESS_POINT": "PMC/SC must witness. Work may NOT proceed without witnessing.",
        "HOLD_POINT": "Requires explicit release by all signatories.",
        "REVIEW_POINT": "Documentation review only. Work may proceed after review."
      },
      "rules": [
        "Failed tests automatically generate punch list items",
        "Un-witnessed witness points must be escalated to PMC"
      ]
    },
    "handover": {
      "kind": "handover",
      "label": "handover procedure",
      "match_phrases": [
        "handover"
      ],
      "title": "Handover Procedure",
      "category": "quality",
      "purpose": "Formal handover of completed works from Contractor to Employer",
      "prerequisites": [
        "All T&C complete with passing results (testing and commissioning procedure)",
        "All NCRs closed (non-conformance procedure)",
        "All punch list items cleared",
        "As-built drawings issued",
        "O&M manuals submitted",
        "Training completed",
        "Warranties and guarantees issued"
      ],
      "handover_documents": [
        "Certificate of Practical Completion (CPC)",
        "Defects Liability Period (DLP) start date",
        "Final snag list",
        "Handover register signed by all parties"
      ]
    },
    "inspection_request": {
      "kind": "inspection_request",
      "label": "inspection request procedure",
      "match_phrases": [
        "inspection procedure",
        "inspection request",
        "construction inspection"
      ],
      "title": "Construction Inspection Procedure",
      "category": "quality",
      "purpose": "Process for Contractor Inspection Requests",
      "document_prefix": "IR",
      "document_format": "IR-{4d}",
      "notice_periods": {
        "standard": "24 hours minimum",
        "structural_hold_point": "48 hours minimum"
      },
      "result_options": [
        "ACCEPTED",
        "REJECTED",
        "CONDITIONAL"
      ],
      "result_rules": {
        "REJECTED": "Contractor must re-submit IR",
        "CONDITIONAL": "NCR raised under the non-conformance procedure"
      },
      "roles": {
        "process_owner": "PMC Delivery Manager",
        "initiator": "Contractor",
        "signatory": "Supervision Consultant",
        "approver": "Employer's Representative"
      }
    },
    "hse_audit": {
      "kind": "hse_audit",
      "label": "HSE audit and inspection procedure",
      "match_phrases": [
        "hse audit",
        "hse inspection",
        "hse"
      ],
      "title": "HSE Audit and Inspection Procedure",
      "category": "hse",
      "purpose": "HSE audits and inspections across the project",
      "cadence": {
        "inspections": "Monthly",
        "formal_audits": "Quarterly"
      },
      "risk_categories": [
        "FATALITY_RISK",
        "SERIOUS_INJURY_RISK",
        "MINOR_INJURY_RISK",
        "ENVIRONMENTAL",
        "NEAR_MISS"
      ],
      "stop_work": {
        "who_can_issue": "Any team member",
        "trigger": "Immediate life-safety risk",
        "resumption_authority": "PMC Project Director written sign-off required"
      }
    },
    "design_review": {
      "kind": "design_review",
      "label": "design review and acceptance procedure",
      "match_phrases": [
        "design review",
        "design acceptance"
      ],
      "title": "Design Reviews & Acceptance",
      "category": "design",
      "purpose": "Review, comment, and accept design documentation",
      "review_statuses": {
        "FOR_COMMENT": "Reviewer marks up and issues comments. PMT Design Manager coordinates.",
        "ACCEPTANCE": "Employer satisfied design meets value expectations.",
        "BUY_OFF": "Equivalent to Acceptance for creative elements."
      },
      "forbidden_term": "APPROVED - never use this word on design documents",
      "timeline": {
        "min_distribution_days": 7,
        "max_distribution_days": 14,
        "workshop_duration_days": "1-2"
      },
      "templates": {
        "design_review_schedule": "Design Review Schedule",
        "design_review_comments_schedule": "Design Review Comments Schedule",
        "roles_responsibility_matrix": "Roles & Responsibility Matrix",
        "design_package_acceptance_form": "Design Package Acceptance Form",
        "project_decision_note": "Project Decision Note (PDN)",
        "design_coordination_meeting_record": "Design Coordination Meeting Record",
        "design_progress_evaluation": "Design Progress Evaluation",
        "design_exceptions_justification_report": "Design Exceptions Justification Report",
        "workshop_design_decision_form": "Workshop Design Decision Approval Form",
        "design_directive_form": "Design Directive Form"
      },
      "acceptance_forms": {
        "standard": "design_package_acceptance_form",
        "decision_note": "project_decision_note",
        "workshop": "workshop_design_decision_form"
      },
      "workflow": [
        "PMT prepares Design Review Schedule",
        "Designer issues Design Package (min 7 cal days before workshop)",
        "All reviewers prepare marked-up sets independently",
        "Design Review Workshop (1-2 days): Creative Consultant leads creative; PMT leads technical/commercial",
        "Compile & distribute Design Review Comments",
        "Designer amends design per agreed comments",
        "PMT reviews and recommends acceptance",
        "Employer signs Design Package Acceptance Form",
        "Issue for IP Review & Approvals"
      ],
      "raci": {
        "Employer": {
          "code": "A",
          "meaning": "Acceptance authority"
        },
        "PMT": {
          "code": "P/PR",
          "meaning": "Preparation and Primary Review"
        },
        "Creative Consultant": {
          "code": "PR",
          "meaning": "Primary Review on creative elements"
        },
        "Cost Consultant": {
          "code": "C",
          "meaning": "Comment"
        },
        "Operator": {
          "code": "C",
          "meaning": "Comment"
        },
        "Statutory Bodies / 3rd Party Inspector": {
          "code": "I",
          "meaning": "Informed"
        },
        "Turnkey Contractor": {
          "code": "P",
          "meaning": "Preparation"
        },
        "3rd Party Contractors / Suppliers": {
          "code": "P",
          "meaning": "Preparation"
        }
      },
      "design_phases": [
        "General/All Phases",
        "Feasibility",
        "Concept Design",
        "Schematic Design",
        "Detailed Design",
        "Construction Documents"
      ]
    },
    "design_directive": {
      "kind": "design_directive",
      "label": "design directive procedure",
      "match_phrases": [
        "design directive"
      ],
      "title": "Design Directives",
      "category": "design",
      "purpose": "Formal instructions from PMT to Contractor/Consultant for design changes",
      "document_prefix": "DD",
      "document_format": "DD-{3d}",
      "key_rule": "A DD does NOT constitute a Variation Settlement or Variation Order",
      "critical_rule": "No work on any instruction may proceed until the DD has Employer approval",
      "roles": {
        "authorizer": "Project Director",
        "implementer": "Head of Design Management",
        "executor": "Delivery Manager(s)"
      },
      "integration": "Must be used alongside the change management procedure when scope or cost is affected"
    },
