      {
        "name": "work_item",
        "label": "planner template row (work item, as the row names it)",
        "type": "text",
        "unit": "",
        "range": null,
        "required": true,
        "basis": ""
      },
      {
        "name": "quantity",
        "label": "quantity of the work item",
        "type": "number",
        "unit": "",
        "range": [
