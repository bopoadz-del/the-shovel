  "kind": "knowledge",
  "facts": {
    "name": "Temperature drop equivalent to a strain",
    "described_as": "Thermal strain = alpha x dT, so a strain (for example a shrinkage strain) equals a temperature drop dT = strain / alpha. The course quotes alpha 7.2e-6 to 10.8…",
    "inputs": [
      {
        "name": "strain",
        "label": "Strain to express as a temperature change",
        "type": "number",
        "unit": "dimensionless",
        "range": null,
        "required": true,
        "basis": ""
      },
      {
        "name": "thermal_coefficient",
        "label": "Coefficient of thermal expansion alpha",
        "type": "number",
        "unit": "1/delta_degC",
        "range": null,
        "required": true,
        "basis": ""
      }
    ],
    "outputs": [
      {
        "name": "result",
        "unit": "delta_degC",
        "main": true
      }
