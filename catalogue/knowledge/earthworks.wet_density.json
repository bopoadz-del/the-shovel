  "facts": {
    "name": "Wet (bulk) density from a weighed sample of known volume",
    "described_as": "Wet density = (mass of container + soil - mass of container) / volume. In the compaction (Proctor) test the container is the mould and the volume is the mould…",
    "inputs": [
      {
        "name": "gross_mass",
        "label": "Mass of container (mould) plus wet soil",
        "type": "number",
        "unit": "gram",
        "range": null,
        "required": true,
        "basis": ""
      },
      {
        "name": "container_mass",
        "label": "Mass of the empty container (mould); 0 when the soil is weighed net",
        "type": "number",
        "unit": "gram",
        "range": null,
        "required": true,
        "basis": ""
      },
      {
        "name": "volume",
        "label": "Volume the soil occupies (mould volume or test-hole volume)",
        "type": "number",
        "unit": "centimeter**3",
        "range": null,
        "required": true,
        "basis": ""
      }
    ],
    "outputs": [
