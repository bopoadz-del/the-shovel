# The Fork — on-prem (air-gapped) environment template. STEP 2.
#
# Copy to `onprem.env` and source it (or feed it to docker-compose --env-file)
# on the on-prem host. These values make the app zero-egress. The app ASSERTS
# the critical ones at boot (app/core/deployment_profile.py:check_onprem_ready)
# and refuses to start if any would leak. The offline model flags MUST come from
# the environment (here / Dockerfile ENV) — they are read by transformers at
# import time and cannot be set from Python.

# ── Profile switch ─────────────────────────────────────────────────────────
DEPLOYMENT_PROFILE=onprem

# ── LLM: local Ollama ONLY (no cloud provider, no cloud tunnel) ─────────────
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# OLLAMA_API_KEY must be EMPTY — a key means Ollama Cloud (egress). Leave unset.
OLLAMA_MODEL=qwen2.5:7b-instruct
# Cloud provider keys MUST be unset: GROQ_API_KEY / KIMI_API_KEY.

# ── Offline model loading (asserted at boot; set here, never from Python) ───
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
YOLO_OFFLINE=1
# Embedder: point at a locally-bundled weights dir (STEP 4 bakes it in).
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# HF_HOME=/app/data/hf-cache  # pre-seeded cache path (persistent volume)

# ── Observability: local only, no telemetry ────────────────────────────────
# SENTRY_DSN must be UNSET (asserted). Errors go to local structured logging.

# ── Storage / DB: local ─────────────────────────────────────────────────────
DATA_DIR=/app/data
# DATABASE_URL=postgresql://fork:fork@postgres:5432/fork   # local PG (compose)
# Unset DATABASE_URL to use bundled SQLite under DATA_DIR.

# ── Retrieval isolation (STEP 0) — pilot master corpus stays local ──────────
RAG_GENERAL_KNOWLEDGE_PROJECTS=curated_kb

# ── Required app secrets (generate locally; never reuse cloud values) ───────
# SECRET_KEY=...
# DATA_ENCRYPTION_KEY=...
# CEREBRUM_MASTER_KEY=...
