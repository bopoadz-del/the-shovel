# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Local agent / subagent worktrees (created at runtime by Claude Code agents).
.claude/worktrees/

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/
.venv-*/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Environment variables (master copies live in the password-manager vault)
.env
.env.local
.env.*.local

# pytest
.pytest_cache/
.coverage

# mypy
.mypy_cache/
.dmypy.json
dmypy.json
frontend/node_modules

# Secrets vault (plaintext removed - see vault/secrets.tar.gz.gpg)
.ssh/
.render/

vault/secrets.tar.gz
claudebot/KEYS.md

# Claude Code local settings (personal, machine-specific)
.claude/settings.local.json

# Runtime data directory at repo root (uploads, SQLite DB, audit log,
# captures). Anchored with leading slash so app/data/ (versioned content like
# the procedures DB) is NOT swept up by this rule. The only tracked file under
# it is the model manifest: the weights themselves are a release asset of this
# repo, fetched and sha256-verified by scripts/fetch_model.py.
/data/*
!/data/models/
/data/models/*
!/data/models/manifest.json
.playwright-mcp/

# wrangler / Cloudflare Workers local state
.wrangler
.dev.vars*
!.dev.vars.example

# Dead Chroma vector DB directory (PR #98 — Chroma never wired in app/;
# unified retriever is pgvector via app.core.rag.vector_store). Block
# accidental re-commit of any local chroma scratch files.
data/chroma_db/

# YOLO base/scratch artifacts (local-only). The BAKED .onnx we ship is a
# release asset (see data/models/manifest.json), never a git object.
/runs/
/yolov8n.pt
/yolov8s-world.pt
/yolov8s-worldv2.pt
/yolov8m-worldv2.pt
/weights/
coverage.xml
coverage.json
.worktrees/

# Runtime / diagnostic logs — written by the app (sandbox shell audit,
# migration runs) and by review tooling. Never track log output.
logs/
*.log
review_pack/**/*.log
.onprem-lite-data/
.onprem-accept-data/

# Evaluation photographs: fetched by scripts/fetch_eval_photos.py, never committed.
# Only tests/fixtures/photo_eval_manifest.json is tracked.
tests/fixtures/photos/

# Playwright nightly (local + Actions artifact workspace)
/test-results/
/playwright-report/
/blob-report/


# Repo hygiene (scripts/scan_repo_hygiene.py enforces the same in CI):
# documents, captures, eval output, local databases and model weights never
# live in git. Knowledge and codes go in through the admin path into the
# database; only text seeds under docs/knowledge/ ship with the code.
/uploads/
uploads/
captures/
*results*.jsonl
/review_pack/
/artifacts/
*.db
*.sqlite
*.sqlite3
*.sqlite-*
*.db-journal
*.db-wal
*.db-shm
*.onnx
*.pt
*.pth
*.safetensors
*.ckpt
*.h5
*.tflite
*.pb
*.engine
/GOLDEN_SET_REPORT.md
/FEATURE_MATRIX.md
/.ci-investigation/

# Ingest run-state sidecar: a per-file heartbeat written by
# scripts/p1b_ingest_drive_server.py so a SIGKILLed run can still be
# post-mortemed on the next start. Machine-local runtime state, never
# review material — it is regenerated by every run and would otherwise
# land in a PR as a diff of one live box's memory numbers.
manifests/p1b_ingest_run_state*.json

# Client Drive manifests and backfill worklists carry client folder trees and
# filenames. They are operator artifacts, kept in the secrets backup, never git.
manifests/p1a_drive_manifest_client.json
manifests/p1a_local_drive_manifest.json
rag_backfill_indexable_candidates.json
rag_backfill_batch_*.json
.mutation_in_flight
